{
  "tests": [
    {
      "name": "Test missing token",
      "method": "GET",
      "path": "/",
      "expectedStatus": 400,
      "expectedBody": {
        "error": "Токен доступа обязателен"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Test invalid token",
      "method": "GET",
      "path": "/?token=invalid_token_123",
      "expectedStatus": 404,
      "expectedBody": {
        "error": "Заключение не найдено или ссылка недействительна"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Test CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200,
      "expectedBody": "",
      "bodyMatcher": "exact"
    }
  ]
}