{
  "tests": [
    {
      "name": "OPTIONS request for CORS",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "POST lead with valid data and messengers",
      "method": "POST",
      "path": "/",
      "body": {
        "childName": "Тестовый Ребенок",
        "parentName": "Тестовый Родитель",
        "phone": "+79236251611",
        "messengers": [
          "Telegram",
          "Max"
        ],
        "telegram": "@testuser",
        "marketingConsent": true,
        "utm": {
          "utm_source": "yandex",
          "utm_medium": "cpc",
          "utm_campaign": "test_campaign",
          "utm_content": "ad1"
        }
      },
      "expectedStatus": 200,
      "expectedBody": {
        "success": true
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Feed without service key",
      "method": "GET",
      "path": "/?action=feed",
      "expectedStatus": 401
    },
    {
      "name": "First message without service key",
      "method": "POST",
      "path": "/?action=first-message",
      "body": {
        "leadId": 227
      },
      "expectedStatus": 401
    },
    {
      "name": "First reply without service key",
      "method": "POST",
      "path": "/?action=first-reply",
      "body": {
        "leadId": 227
      },
      "expectedStatus": 401
    }
  ]
}