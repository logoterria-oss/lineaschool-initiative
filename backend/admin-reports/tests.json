{
  "tests": [
    {
      "name": "Test admin auth required",
      "method": "GET",
      "path": "/",
      "expectedStatus": 401,
      "expectedBody": {
        "error": "Неверный пароль администратора"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Удаление требует пароль",
      "method": "DELETE",
      "path": "/?id=1",
      "expectedStatus": 401,
      "expectedBody": {
        "error": "Неверный пароль администратора"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Удаление запрещено без сессии",
      "method": "DELETE",
      "path": "/?id=999999999",
      "headers": {
        "X-Admin-Password": "426874"
      },
      "expectedStatus": 403,
      "expectedBody": {
        "error": "Удалять заключения может только руководитель школы Абраменко Виктория"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Удаление запрещено с чужим токеном",
      "method": "DELETE",
      "path": "/?id=999999999",
      "headers": {
        "X-Admin-Password": "426874",
        "X-Auth-Token": "fake-token-not-in-db"
      },
      "expectedStatus": 403,
      "expectedBody": {
        "error": "Удалять заключения может только руководитель школы Абраменко Виктория"
      },
      "bodyMatcher": "partial"
    }
  ]
}