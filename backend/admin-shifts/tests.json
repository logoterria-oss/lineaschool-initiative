{
  "tests": [
    {
      "name": "Смены за месяц",
      "method": "GET",
      "path": "/?month=2026-08",
      "expectedStatus": 200,
      "expectedBody": {
        "month": "2026-08"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Отметка смены без входа закрыта",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "start",
        "date": "2026-08-18"
      },
      "expectedStatus": 401,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Состояние смены без входа закрыто",
      "method": "GET",
      "path": "/?action=my-shift&date=2026-08-18",
      "expectedStatus": 401,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Кто сейчас на смене",
      "method": "GET",
      "path": "/?action=on-shift",
      "expectedStatus": 200,
      "expectedBody": {
        "ok": true
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Синхронизация смены с окном взаимодействия",
      "method": "GET",
      "path": "/?action=sync-interaction",
      "expectedStatus": 200,
      "expectedBody": {
        "ok": true
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Чек-лист без входа закрыт",
      "method": "GET",
      "path": "/?action=checklist&date=2026-08-27",
      "expectedStatus": 401,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Задачи руководителя на дату",
      "method": "GET",
      "path": "/?action=head-tasks&date=2026-08-27",
      "expectedStatus": 200,
      "expectedBody": {
        "ok": true
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Месяц обязателен",
      "method": "GET",
      "path": "/",
      "expectedStatus": 400,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Шаблон без дат",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "fill-template"
      },
      "expectedStatus": 400,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Забрать смену без входа закрыто",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "start",
        "take_over": true
      },
      "expectedStatus": 401,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Напоминания без входа закрыты",
      "method": "GET",
      "path": "/?action=reminders",
      "expectedStatus": 401,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Подтверждение Окна без ключа закрыто",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "reminder-confirm",
        "reminder_id": 1
      },
      "expectedStatus": 403,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "История смен без дат",
      "method": "GET",
      "path": "/?action=shift-history",
      "expectedStatus": 400,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    }
  ]
}