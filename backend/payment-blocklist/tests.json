{
  "tests": [
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "GET blocklist",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Reject wrong password on unblock",
      "method": "POST",
      "path": "/",
      "headers": {"X-Admin-Password": "wrong"},
      "body": {"id": 1},
      "expectedStatus": 401
    },
    {
      "name": "Reject bad id",
      "method": "POST",
      "path": "/",
      "headers": {"X-Admin-Password": "426874"},
      "body": {"id": "abc"},
      "expectedStatus": 400
    }
  ]
}