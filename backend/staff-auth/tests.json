{
  "tests": [
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Register validation - bad phone",
      "method": "POST",
      "path": "/",
      "body": {"action": "register", "full_name": "Тест Тестов", "phone": "123", "password": "secret1", "role": "teacher"},
      "expectedStatus": 400,
      "expectedBody": {"error": "bad_phone"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Login bad credentials",
      "method": "POST",
      "path": "/",
      "body": {"action": "login", "phone": "+70000000000", "password": "nope123"},
      "expectedStatus": 401,
      "expectedBody": {"error": "bad_credentials"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Set avatar without session",
      "method": "POST",
      "path": "/",
      "body": {"action": "set_avatar", "content_type": "image/png", "image_base64": "AAAA"},
      "expectedStatus": 401,
      "expectedBody": {"error": "no_session"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Set title without session",
      "method": "POST",
      "path": "/",
      "body": {"action": "set_title", "job_title": "Старший методист"},
      "expectedStatus": 401,
      "expectedBody": {"error": "no_session"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Set phone without session",
      "method": "POST",
      "path": "/",
      "body": {"action": "set_phone", "phone": "+79001234567"},
      "expectedStatus": 401,
      "expectedBody": {"error": "no_session"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Register bad email",
      "method": "POST",
      "path": "/",
      "body": {"action": "register", "full_name": "Тест Тестов", "phone": "+79001112233", "email": "notanemail", "password": "secret1", "role": "teacher"},
      "expectedStatus": 400,
      "expectedBody": {"error": "bad_email"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Verify email not found",
      "method": "POST",
      "path": "/",
      "body": {"action": "verify_email", "phone": "+70000000000", "code": "123456"},
      "expectedStatus": 404,
      "expectedBody": {"error": "not_found"},
      "bodyMatcher": "partial"
    }
  ]
}