{
  "tests": [
    {
      "name": "Старое заключение открывается по номеру",
      "method": "GET",
      "path": "/?id=19",
      "expectedStatus": 200,
      "expectedBody": {
        "success": true,
        "id": 19
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Новое заключение открывается по коду",
      "method": "GET",
      "path": "/?id=942475",
      "expectedStatus": 200,
      "expectedBody": {
        "success": true,
        "id": 233
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Новое заключение недоступно по номеру",
      "method": "GET",
      "path": "/?id=233",
      "expectedStatus": 404,
      "expectedBody": {
        "success": false
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Несуществующее заключение",
      "method": "GET",
      "path": "/?id=999999",
      "expectedStatus": 404,
      "expectedBody": {
        "success": false
      },
      "bodyMatcher": "partial"
    }
  ]
}
