{
  "tests": [
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Список прошлых диагностик ученика",
      "method": "GET",
      "path": "/?name=Тест Промежуточный",
      "expectedStatus": 200,
      "expectedBody": {"success": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "GET без имени возвращает ошибку",
      "method": "GET",
      "path": "/",
      "expectedStatus": 400,
      "expectedBody": {"success": false},
      "bodyMatcher": "partial"
    },
    {
      "name": "Неизвестное действие",
      "method": "POST",
      "path": "/",
      "body": {"action": "unknown"},
      "expectedStatus": 400,
      "expectedBody": {"success": false},
      "bodyMatcher": "partial"
    }
  ]
}
