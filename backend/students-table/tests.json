{
  "tests": [
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Students list",
      "method": "GET",
      "path": "/?mode=list",
      "expectedStatus": 200
    },
    {
      "name": "Save override",
      "method": "POST",
      "path": "/",
      "body": {"action": "save_override", "student_id": 999999, "conclusion": "тестовая форма"},
      "expectedStatus": 200,
      "expectedBody": {"success": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "Save vacation",
      "method": "POST",
      "path": "/",
      "body": {"action": "save_vacation", "student_id": 999999, "date_from": "2026-07-01", "date_to": "2026-08-31"},
      "expectedStatus": 200,
      "expectedBody": {"success": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "Save vacation partial (only date_to keeps date_from)",
      "method": "POST",
      "path": "/",
      "body": {"action": "save_vacation", "student_id": 999999, "date_to": "2026-09-15", "vacation_end_type": "exact"},
      "expectedStatus": 200,
      "expectedBody": {"success": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "CRM admins",
      "method": "GET",
      "path": "/?mode=admins",
      "expectedStatus": 200
    },
    {
      "name": "Save comment",
      "method": "POST",
      "path": "/",
      "body": {"action": "save_comment", "student_id": 999999, "comment_date": "2026-07-08", "done": "тест", "parent_reply": "ок", "extra": "—"},
      "expectedStatus": 200,
      "expectedBody": {"success": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "Delete comment (nonexistent)",
      "method": "POST",
      "path": "/",
      "body": {"action": "delete_comment", "id": 999999999},
      "expectedStatus": 200,
      "expectedBody": {"success": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "Save interaction",
      "method": "POST",
      "path": "/",
      "body": {"action": "save_interaction", "student_id": 999999, "request_source": "parent", "request_date": "2026-07-10", "request_text": "тест запрос", "done": true, "done_text": "перезвонили родителю", "replies": [{"reply_source": "admin", "reply_date": "2026-07-11", "reply_text": "тест ответ"}]},
      "expectedStatus": 200,
      "expectedBody": {"success": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "Set interaction ok",
      "method": "POST",
      "path": "/",
      "body": {"action": "set_interaction_ok", "student_id": 999999, "ok": false},
      "expectedStatus": 200,
      "expectedBody": {"success": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "Delete interaction (nonexistent)",
      "method": "POST",
      "path": "/",
      "body": {"action": "delete_interaction", "id": 999999999},
      "expectedStatus": 200,
      "expectedBody": {"success": true},
      "bodyMatcher": "partial"
    }
  ]
}