{
  "tests": [
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Без входа закрыто",
      "method": "GET",
      "path": "/",
      "expectedStatus": 401,
      "expectedBody": {
        "ok": false
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Сводка без ключа закрыта",
      "method": "GET",
      "path": "/?action=digest",
      "expectedStatus": 403
    },
    {
      "name": "Новые задачи без ключа закрыты",
      "method": "GET",
      "path": "/?action=new-tasks",
      "expectedStatus": 403
    },
    {
      "name": "Напоминания смены без ключа закрыты",
      "method": "GET",
      "path": "/?action=shift-reminders",
      "expectedStatus": 403
    },
    {
      "name": "Педагог без входа видит форму проблемы",
      "method": "GET",
      "path": "/?problem=1",
      "expectedStatus": 200,
      "expectedBody": {
        "ok": true
      },
      "bodyMatcher": "partial"
    }
  ]
}