{
  "tests": [
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "List dialogs",
      "method": "GET",
      "path": "/?action=dialogs",
      "expectedStatus": 200
    },
    {
      "name": "Unknown action",
      "method": "POST",
      "path": "/",
      "body": {"foo": "bar"},
      "expectedStatus": 400
    },
    {
      "name": "TG webhook skips own message",
      "method": "POST",
      "path": "/?action=tg-webhook",
      "body": {"message": {"chat_id": "123456", "from_me": true, "body": "hi"}},
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "TG webhook incoming message",
      "method": "POST",
      "path": "/?action=tg-webhook",
      "body": {"message": {"chat_id": "999000111", "senderName": "Тест ТГ", "username": "testuser", "body": "Здравствуйте"}},
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "Set contacts manually",
      "method": "POST",
      "path": "/?action=set-contacts",
      "body": {"dialog_id": 3, "phone": "89991234567", "tgUsername": "@ivan"},
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    }
  ]
}