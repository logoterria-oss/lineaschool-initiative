{
  "manifest_version": 3,
  "name": "OpenDyslexic - Шрифт для дислексиков",
  "version": "1.0.0",
  "description": "Меняет шрифт на всех сайтах на OpenDyslexic для упрощения чтения людям с дислексией. Поддержка русского и английского языков.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "icons": {
    "128": "icon.svg"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["opendyslexic.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2",
        "fonts/*.woff",
        "fonts/*.ttf"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}